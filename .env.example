# Copy to .env.local and fill in. Never commit real secrets.
#
# Every variable here is read in exactly one place: src/shared/config/env.ts
# (server) or src/shared/config/publicEnv.ts (browser). Nothing else touches
# process.env.
#
# Operator-tunable limits — upload size, file count, retention windows — are
# NOT here. They live in the database and are edited at /admin/settings, because
# they belong to Yuta rather than to a deploy.

# Public base URL (no trailing slash). Used for Stripe return URLs and links
# inside transactional emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Postgres) ------------------------------------------------
# Dockerized locally (see docker-compose.yml); Supabase in prod, where the
# integration supplies POSTGRES_URL and either name is accepted.
DATABASE_URL=postgres://app:app@localhost:5434/baseball

# --- Auth (operator portal) ---------------------------------------------
# Signing secret for the jose session cookies. Generate one:
#   openssl rand -base64 32
# It signs two different cookies: the operator session, and the customer's
# short-lived flow cookie that gates uploading before payment.
AUTH_SECRET=

# --- Site gate (optional) -----------------------------------------------
# Set BOTH to hide the whole site behind a browser username/password prompt
# (HTTP Basic Auth) while it's being built. /api routes are excluded so
# webhooks still work. Clear both + redeploy to lift the gate. Leave unset
# locally so dev isn't prompted.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
# First admin, created by `npm run db:seed`. Dev defaults apply if unset.
SEED_ADMIN_EMAIL=yuta@example.com
SEED_ADMIN_PASSWORD=changeme123
# Dev only: set to 1 to also seed a sample coach + submissions. NEVER in prod.
SEED_SAMPLES=1

# --- Object storage -----------------------------------------------------
# Dev: local disk under this dir, with uploads proxied through /api/upload.
# Prod: leave STORAGE_DIR unset and set BLOB_READ_WRITE_TOKEN — the browser
# then uploads straight to Blob, which is the only way past Vercel's ~4.5 MB
# limit on a serverless request body.
STORAGE_DIR=./.storage
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx      # prod only (Vercel Blob)

# --- Stripe -------------------------------------------------------------
# Publishable key (pk_...) from https://dashboard.stripe.com/apikeys.
# Sent to the browser on purpose — it can only create payment attempts, never
# read or move money. Must be from the SAME mode (test/live) as the secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret for the webhook (Developers → Webhooks, or the secret printed
# by `stripe listen` during local development). Test and live mode have
# SEPARATE endpoints and separate secrets.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional. A pre-created Price ID (price_...). Leave unset to price the
# payment inline from the amount in src/shared/config/site.ts.
# STRIPE_PRICE_ID=price_xxx

# --- Retention sweep (Vercel Cron) --------------------------------------
# Shared secret Vercel Cron presents as `Authorization: Bearer <secret>` when
# it calls /api/cron/sweep. Generate one: `openssl rand -hex 32`.
# The route REFUSES to run if this is unset — an unguarded endpoint that
# deletes customer files is worse than a sweep that never runs.
CRON_SECRET=

# Optional. Seconds a password-reset link stays valid; defaults to 3600 (one
# hour). Only set this to walk the expired-link path by hand without waiting —
# e.g. 15 in a test env, then remove it. A malformed or non-positive value
# falls back to the default. Never set it low in production.
# PASSWORD_RESET_TTL_S=

# --- Email (Resend) -----------------------------------------------------
# Optional. If unset, emails are skipped (logged, never fatal) — but note the
# verification code is emailed, so the customer flow cannot be completed
# without it. Set it before testing the flow end to end.
# RESEND_API_KEY=re_xxx
# Who mail is sent AS. Must be an address on a domain verified in Resend, or
# every send is rejected. Leave unset until the domain is verified — the
# fallback (Resend's onboarding sender) works to the account owner's address,
# which is enough for local testing.
# RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Baseball Sensei <contact@baseball-sensei.com>

# Optional QA instrumentation. Unset = off entirely: every /api/qa/* route
# answers 404 and the probe never activates. Set it only for a QA pass, and
# unset it afterwards. It gates a production endpoint — use a real secret.
QA_TOKEN=
