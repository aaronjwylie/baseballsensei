{
  "name": "dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-names.mjs && node scripts/check-doctrine.mjs && node scripts/check-structure.mjs && node scripts/migrate-on-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "simulate": "tsx --tsconfig tsconfig.json scripts/simulate.ts",
    "db:ladder": "tsx --tsconfig tsconfig.json scripts/seed-ladder.ts",
    "payment": "tsx --tsconfig tsconfig.json scripts/test-payment.ts",
    "flow": "tsx --tsconfig tsconfig.json scripts/test-flow.ts",
    "stripe": "tsx --tsconfig tsconfig.json scripts/stripe-webhook.ts",
    "db:baseline": "tsx --tsconfig tsconfig.json scripts/baseline-migrations.ts",
    "check:names": "node scripts/check-names.mjs",
    "check:doctrine": "node scripts/check-doctrine.mjs",
    "check:structure": "node scripts/check-structure.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.5",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "stripe": "^22.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
